{
  "title": "Countermapping",
  "defaultBoard": "data/boards/sample-board.json",
  "map": {
    "center": [
      38.9072,
      -77.0369
    ],
    "zoom": 12,
    "layerOrder": [
      "Wards",
      "Snow Removal Requests"
    ],
    "baselayer": {
      "name": "OpenStreetMap",
      "url": "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
      "attribution": "&copy; OpenStreetMap contributors"
    },
    "baselayers": [
      {
        "name": "OpenStreetMap",
        "url": "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
        "attribution": "&copy; OpenStreetMap contributors"
      },
      {
        "name": "Satellite (Hybrid)",
        "url": "https://mt1.google.com/vt/lyrs=y&x={x}&y={y}&z={z}",
        "attribution": "&copy; Google"
      },
      {
        "name": "Satellite (USGS)",
        "url": "https://basemap.nationalmap.gov/arcgis/rest/services/USGSImageryOnly/MapServer/tile/{z}/{y}/{x}",
        "attribution": "USGS"
      }
    ]
  },
  "layers": [
    {
      "name": "Wards",
      "file": "data/layers/Ward_-_2022.geojson",
      "layerType": "simple",
      "style": {
        "color": "#1f2937",
        "weight": 2,
        "fillColor": "#9ca3af",
        "fillOpacity": 0.08
      },
      "popup": {
        "enabled": true,
        "titleField": "NAME",
        "fields": [
          {
            "field": "REP_NAME",
            "label": "Councilmember"
          },
          {
            "field": "REP_PHONE",
            "label": "Phone"
          }
        ]
      }
    },
    {
      "name": "Snow Removal Requests",
      "file": "data/layers/Residential_Snow_Removal_Service_Requests.geojson",
      "layerType": "categorical",
      "valueField": "SERVICEORDERSTATUS",
      "legendTitle": "Snow removal requests",
      "categories": [
        {
          "value": "Open",
          "label": "Open",
          "color": "#d1495b"
        },
        {
          "value": "Closed",
          "label": "Closed",
          "color": "#2e4057"
        }
      ],
      "nullColor": "#9ca3af",
      "noDataLabel": "Other",
      "pointShape": "circle",
      "pointStyle": {
        "radius": 4,
        "color": "#ffffff",
        "weight": 1,
        "fillOpacity": 0.85
      },
      "popup": {
        "enabled": true,
        "titleField": "STREETADDRESS",
        "descriptionField": "SERVICECODEDESCRIPTION",
        "fields": [
          {
            "field": "SERVICEORDERSTATUS",
            "label": "Status"
          },
          {
            "field": "ADDDATE",
            "label": "Requested"
          },
          {
            "field": "RESOLUTIONDATE",
            "label": "Resolved"
          },
          {
            "field": "WARD",
            "label": "Ward"
          },
          {
            "field": "SERVICEREQUESTID",
            "label": "Request ID"
          },
          {
            "field": "DETAILS",
            "label": "Details"
          }
        ]
      }
    }
  ]
}
